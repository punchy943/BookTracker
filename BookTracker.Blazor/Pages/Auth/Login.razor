@page "/login"

@inject BookTrackerClient BookTrackerClient
@inject IAuthSession AuthSession
@inject NavigationManager NavigationManager

@using BookTracker.Blazor.Models.Auth
@using BookTracker.Blazor.Api
@using BookTracker.Blazor.Auth


<h1>Inloggen</h1>

@if (isSubmitting)
{
    <p>Bezig met inloggen.</p>
}

<EditForm Model="model" OnValidSubmit="HandleLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <label for="email">Email</label>
    <InputText id="email" @bind-Value="model.Email" />
    <ValidationMessage For="@(() => model.Email)" />

    <label for="password">Password</label>
    <InputText id="password"
               type="password"
               @bind-Value="model.Password" />

    <button type="submit" disabled="@isSubmitting">Inloggen</button>
</EditForm>

@if (invalidCredentials)
{
    <p>E-mail adres of wachtwoord is verkeerd.</p>
}

@if (error is not null)
{
    <p>@error</p>
}

@code {
    private readonly LoginRequest model = new();
    private bool isSubmitting;
    private string? error;
    private bool invalidCredentials;

    private async Task HandleLogin()
    {
        isSubmitting = true; 
        error = null;
        invalidCredentials = false; 

        try 
        {
            var response = await BookTrackerClient.Login(model);

            if (response is null)
            {
                invalidCredentials = true;
            }
            else 
            {
                await AuthSession.SetTokenAsync(response.AccessToken);
                NavigationManager.NavigateTo("/booktracker");
            }
        }
        
        catch
        {
            error = "Inloggen mislukt, is de Api bereikbaar?";
        }

        finally
        {
            isSubmitting = false;
        }
    }
}